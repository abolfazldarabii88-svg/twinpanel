{
  "name": "twinpanel-desktop",
  "version": "1.5.2",
  "private": true,
  "description": "TwinPanel desktop workspace for Telegram and ChatGPT",
  "author": "TwinPanel",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/make-icon.js && electron .",
    "dist": "node scripts/make-icon.js && electron-builder --win nsis",
    "dist:portable": "node scripts/make-icon.js && electron-builder --win portable",
    "publish:win": "node scripts/make-icon.js && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "tdl": "8.1.0",
    "prebuilt-tdlib": "0.1008067.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mmdibot.twinpanel",
    "productName": "TwinPanel",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "assets/**/*",
      "telegram-native/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "TwinPanel-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "abolfazldarabii88-svg",
        "repo": "twinpanel",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/prebuilt-tdlib/**/*",
      "node_modules/@prebuilt-tdlib/**/*"
    ],
    "npmRebuild": false
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "electron-winstaller@5.4.0": true,
    "tdl@8.1.0": true
  }
}
