{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pisho Notch",
  "version": "0.1.0",
  "identifier": "com.twinpanel.pishonotch",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pisho Notch",
        "width": 200,
        "height": 72,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Tiny animated desktop cat eyes",
    "longDescription": "A tiny transparent always-on-top desktop overlay with animated cat-like eyes."
  }
}
